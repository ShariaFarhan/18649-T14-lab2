#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>

/ {
	aliases {
		steering-servo = &steering_servo;
		blinker-fl = &blinker_fl;
		blinker-fr = &blinker_fr;
		blinker-rl = &blinker_rl;
		blinker-rr = &blinker_rr;
		
		/* Motor Speed PWM Aliases */
		motor-left-pwm  = &motor_l_pwm;
		motor-right-pwm = &motor_r_pwm;

		/* Motor Direction GPIO Aliases */
		motor-left-in1  = &motor_l_in1;
		motor-left-in2  = &motor_l_in2;
		motor-right-in1 = &motor_r_in1;
		motor-right-in2 = &motor_r_in2;
	};

	servo_pwms {
		compatible = "pwm-leds";

		steering_servo: steering-servo {
			pwms = <&pwm1 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

	blinker_outputs {
		compatible = "gpio-leds";

		blinker_fl: blinker-fl { gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>; };
		blinker_fr: blinker-fr { gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>; };
		blinker_rl: blinker-rl { gpios = <&gpioc 8 GPIO_ACTIVE_HIGH>; };
		blinker_rr: blinker-rr { gpios = <&gpioc 9 GPIO_ACTIVE_HIGH>; };
	};

	motor_pwms {
		compatible = "pwm-leds";

		motor_l_pwm: motor_l_pwm { pwms = <&pwm3 2 PWM_KHZ(20) PWM_POLARITY_NORMAL>; };
		motor_r_pwm: motor_r_pwm { pwms = <&pwm3 1 PWM_KHZ(20) PWM_POLARITY_NORMAL>; };
	};

	motor_direction {
		compatible = "gpio-leds";

		/* Physical left wheel: bridge B (PB14, PB15), confirmed during bench test. */
		motor_l_in1: motor_l_in1 { gpios = <&gpiob 14 GPIO_ACTIVE_HIGH>; };
		motor_l_in2: motor_l_in2 { gpios = <&gpiob 15 GPIO_ACTIVE_HIGH>; };

		/* Physical right wheel: bridge A (PB12, PB13). */
		motor_r_in1: motor_r_in1 { gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>; };
		motor_r_in2: motor_r_in2 { gpios = <&gpiob 13 GPIO_ACTIVE_HIGH>; };
	};

	zephyr,user {
		/* ACS712 divider outputs: left PC2, right PC3, servo PC4. */
		io-channels = <&adc1 12>, <&adc1 13>, <&adc1 14>;
		io-channel-names = "left-motor-current", "right-motor-current", "servo-current";
	};

};

/* PA8 is the board's default I2C3 SCL pin, so release it for TIM1_CH1. */
&i2c3 {
	status = "disabled";
};

/* PWM1: Steering Servo (PA8 / TIM1_CH1) */
&timers1 {
	/* 84 MHz / (83 + 1) = 1 MHz, giving 1 us PWM resolution. */
	st,prescaler = <83>;
	status = "okay";

	pwm1: pwm {
		pinctrl-0 = <&tim1_ch1_pa8>;
		pinctrl-names = "default";
		status = "okay";
	};
};

/* PWM3: Drive Motors (PA6/TIM3_CH1 & PA7/TIM3_CH2 at 20 kHz) */
&timers3 {
	status = "okay";

	pwm3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch1_pa6 &tim3_ch2_pa7>;
		pinctrl-names = "default";
	};
};
/* Lab2 wheel encoders: 1320 counts per wheel revolution, supported by ten-turn measurements.
 * Keep Sidrisha's motor TIM3 and Ryan's servo TIM1 assignments unchanged. */
/ {
 aliases {
  encoder-left = &encoder_left;
  encoder-right = &encoder_right;
 };
 pwmleds { status = "disabled"; };
};

/* Default board drivers otherwise claim encoder and motor pins. */
&pwm2 { status = "disabled"; };
&spi1 { status = "disabled"; };
&spi2 { status = "disabled"; };

/* Preserve USART2 debug; reserve the Pi link on PA9/PA10, not PB6/PB7. */
&usart1 {
 pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
 pinctrl-names = "default";
 current-speed = <115200>;
 status = "okay";
};

&timers2 {
 status = "okay";
 st,prescaler = <0>;
 encoder_left: qdec {
  status = "okay";
  pinctrl-0 = <&tim2_ch1_pa0 &tim2_ch2_pa1>;
  pinctrl-names = "default";
  st,encoder-mode = <3>; /* Both A/B edges: x4. */
  st,counts-per-revolution = <1320>;
  st,input-filter-level = <3>;
 };
};
&timers4 {
 status = "okay";
 st,prescaler = <0>;
 encoder_right: qdec {
  status = "okay";
  pinctrl-0 = <&tim4_ch1_pb6 &tim4_ch2_pb7>;
  pinctrl-names = "default";
  st,encoder-mode = <3>;
  st,counts-per-revolution = <1320>;
  st,input-filter-level = <3>;
 };
};

/* Scope markers: shared driver marks final LEFT PWM writes; PWM_OUT taps PA7. */
/ { zephyr,user { pwm-set-test-gpios = <&gpioc 11 GPIO_ACTIVE_HIGH>; }; };

/* USART1 is separate from the USART2 ST-LINK console. */
/ {
 chosen { pilink,uart = &usart1; };
 zephyr,user { cmd-rx-test-gpios = <&gpioc 10 GPIO_ACTIVE_HIGH>; };
};

/* ADC1: ACS712 divider outputs on PC2/IN12, PC3/IN13 and PC4/IN14. */
&adc1 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&adc1_in12_pc2 &adc1_in13_pc3 &adc1_in14_pc4>;
	pinctrl-names = "default";
	status = "okay";

	channel@c {
		reg = <12>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@d {
		reg = <13>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@e {
		reg = <14>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};
};
